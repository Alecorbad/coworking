root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

[*.{csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[backend/src/Coworking.Api/Infrastructure/Migrations/*.cs]
# Scritte da dotnet ef: le regole di analisi non si applicano al codice generato.
generated_code = true
