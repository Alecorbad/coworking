# Copia questo file in .env prima di `docker compose up`.
# Password di test per il database locale, non una credenziale reale.
POSTGRES_PASSWORD=coworking

# Password della receptionist (receptionist@coworking.local), creata all'avvio dell'API.
# Almeno 6 caratteri, con maiuscola, minuscola, cifra e un carattere non alfanumerico.
# Password di test, non una credenziale reale.
RECEPTIONIST_PASSWORD=Coworking1!
