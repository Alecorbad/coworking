  "components": {
    "schemas": {
      "BookingResponse": {
        "required": [
          "id",
          "customerId",
          "customerName",
          "roomId",
          "roomName",
          "startsAt",
          "endsAt",
          "attendees",
          "status",
          "createdAt",
          "cancelledAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificativo della prenotazione.",
            "format": "int32"
          },
          "customerId": {
            "type": "integer",
            "description": "Cliente che ha prenotato.",
            "format": "int32"
          },
          "customerName": {
            "type": "string",
            "description": "Nome e cognome del cliente, per mostrarli senza un'altra richiesta."
          },
          "roomId": {
            "type": "integer",
            "description": "Sala prenotata.",
            "format": "int32"
          },
          "roomName": {
            "type": "string",
            "description": "Nome della sala, per mostrarlo senza un'altra richiesta."
          },
          "startsAt": {
            "type": "string",
            "description": "Inizio, in UTC.",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "description": "Fine esclusa, in UTC.",
            "format": "date-time"
          },
          "attendees": {
            "type": "integer",
            "description": "Partecipanti.",
            "format": "int32"
          },
          "status": {
            "description": "Confirmed oppure Cancelled: le annullate restano visibili.",
            "$ref": "#/components/schemas/BookingStatus"
          },
          "createdAt": {
            "type": "string",
            "description": "Istante della registrazione, in UTC.",
            "format": "date-time"
          },
          "cancelledAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "Istante dell'annullamento, null se confermata.",
            "format": "date-time"
          }
        }
      },
      "BookingStatus": {
        "enum": [
          "Confirmed",
          "Cancelled"
        ],
        "description": "Una prenotazione non si cancella: si annulla e resta visibile nello storico."
      },
      "CreateBookingRequest": {
        "required": [
          "customerId",
          "roomId",
          "startsAt",
          "endsAt",
          "attendees"
        ],
        "type": "object",
        "properties": {
          "customerId": {
            "type": "integer",
            "description": "Cliente che prenota.",
            "format": "int32"
          },
          "roomId": {
            "type": "integer",
            "description": "Sala prenotata; deve essere attiva.",
            "format": "int32"
          },
          "startsAt": {
            "type": "string",
            "description": "Inizio, con fuso (ISO 8601), a passi di mezz'ora nell'ora del coworking.",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "description": "Fine esclusa, dopo l'inizio, nello stesso giorno e dentro gli orari della sala.",
            "format": "date-time"
          },
          "attendees": {
            "type": "integer",
            "description": "Partecipanti, al massimo la capienza della sala.",
            "format": "int32"
          }
        }
      },
      "CreateCustomerRequest": {
        "required": [
          "firstName",
          "lastName",
          "email"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "description": "Nome."
          },
          "lastName": {
            "type": "string",
            "description": "Cognome."
          },
          "email": {
            "type": "string",
            "description": "Unica senza distinguere maiuscole; si salva in minuscolo."
          }
        }
      },
      "CreateRoomRequest": {
        "required": [
          "name",
          "capacity",
          "openingTime",
          "closingTime"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome mostrato nella griglia; unico."
          },
          "capacity": {
            "type": "integer",
            "description": "Partecipanti massimi per prenotazione.",
            "format": "int32"
          },
          "openingTime": {
            "type": "string",
            "description": "Apertura, ora locale del coworking, a passi di mezz'ora.",
            "format": "time"
          },
          "closingTime": {
            "type": "string",
            "description": "Chiusura, dopo l'apertura, a passi di mezz'ora.",
            "format": "time"
          }
        }
      },
      "CustomerResponse": {
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "registeredAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificativo del cliente.",
            "format": "int32"
          },
          "firstName": {
            "type": "string",
            "description": "Nome."
          },
          "lastName": {
            "type": "string",
            "description": "Cognome."
          },
          "email": {
            "type": "string",
            "description": "Email, in minuscolo."
          },
          "registeredAt": {
            "type": "string",
            "description": "Istante della registrazione, in UTC.",
            "format": "date-time"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
