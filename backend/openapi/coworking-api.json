{
  "openapi": "3.1.1",
  "info": {
    "title": "Coworking.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/settings": {
      "get": {
        "tags": [
          "Settings"
        ],
        "summary": "Restituisce il fuso orario del coworking.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms": {
      "get": {
        "tags": [
          "Rooms"
        ],
        "summary": "Elenca tutte le sale in ordine di nome, comprese quelle disattivate.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RoomResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Rooms"
        ],
        "summary": "Crea una sala, attiva.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoomRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoomRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoomRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms/{id}": {
      "get": {
        "tags": [
          "Rooms"
        ],
        "summary": "Legge una sala.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Rooms"
        ],
        "summary": "Modifica una sala, anche per disattivarla o riattivarla.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRoomRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRoomRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRoomRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Rooms"
        ],
        "summary": "Cancella una sala senza prenotazioni; altrimenti va disattivata.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/customers": {
      "get": {
        "tags": [
          "Customers"
        ],
        "summary": "Elenca i clienti in ordine di cognome e nome.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CustomerResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Customers"
        ],
        "summary": "Registra un cliente.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCustomerRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCustomerRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCustomerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/customers/{id}": {
      "get": {
        "tags": [
          "Customers"
        ],
        "summary": "Legge un cliente.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Customers"
        ],
        "summary": "Modifica un cliente.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCustomerRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCustomerRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCustomerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Customers"
        ],
        "summary": "Cancella un cliente senza prenotazioni.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Apre la sessione: la risposta imposta il cookie HttpOnly.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Chiude la sessione.",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Operatore della sessione corrente: il frontend lo usa per sapere se è autenticato.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateCustomerRequest": {
        "required": [
          "firstName",
          "lastName",
          "email"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "description": "Nome."
          },
          "lastName": {
            "type": "string",
            "description": "Cognome."
          },
          "email": {
            "type": "string",
            "description": "Unica senza distinguere maiuscole; si salva in minuscolo."
          }
        }
      },
      "CreateRoomRequest": {
        "required": [
          "name",
          "capacity",
          "openingTime",
          "closingTime"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome mostrato nella griglia; unico senza distinguere maiuscole."
          },
          "capacity": {
            "type": "integer",
            "description": "Partecipanti massimi per prenotazione.",
            "format": "int32"
          },
          "openingTime": {
            "type": "string",
            "description": "Apertura, ora locale del coworking, a passi di mezz'ora.",
            "format": "time"
          },
          "closingTime": {
            "type": "string",
            "description": "Chiusura, dopo l'apertura, a passi di mezz'ora.",
            "format": "time"
          }
        }
      },
      "CustomerResponse": {
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "registeredAt",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificativo del cliente.",
            "format": "int32"
          },
          "firstName": {
            "type": "string",
            "description": "Nome."
          },
          "lastName": {
            "type": "string",
            "description": "Cognome."
          },
          "email": {
            "type": "string",
            "description": "Email, in minuscolo."
          },
          "registeredAt": {
            "type": "string",
            "description": "Istante della registrazione, in UTC.",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "description": "Da rimandare nella modifica: rivela se un altro operatore ha salvato prima.",
            "format": "uint32"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email con cui l'operatore ha fatto l'accesso."
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RoomResponse": {
        "required": [
          "id",
          "name",
          "capacity",
          "openingTime",
          "closingTime",
          "isActive",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificativo della sala.",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "description": "Nome della sala."
          },
          "capacity": {
            "type": "integer",
            "description": "Partecipanti massimi per prenotazione.",
            "format": "int32"
          },
          "openingTime": {
            "type": "string",
            "description": "Apertura, ora locale del coworking.",
            "format": "time"
          },
          "closingTime": {
            "type": "string",
            "description": "Chiusura, ora locale del coworking.",
            "format": "time"
          },
          "isActive": {
            "type": "boolean",
            "description": "false se la sala non accetta nuove prenotazioni."
          },
          "version": {
            "type": "integer",
            "description": "Da rimandare nella modifica: rivela se un altro operatore ha salvato prima.",
            "format": "uint32"
          }
        }
      },
      "SettingsResponse": {
        "required": [
          "timeZone"
        ],
        "type": "object",
        "properties": {
          "timeZone": {
            "type": "string",
            "description": "Fuso IANA in cui il frontend mostra tutti gli orari."
          }
        }
      },
      "UpdateCustomerRequest": {
        "required": [
          "firstName",
          "lastName",
          "email",
          "version"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "description": "Nome."
          },
          "lastName": {
            "type": "string",
            "description": "Cognome."
          },
          "email": {
            "type": "string",
            "description": "Unica senza distinguere maiuscole; si salva in minuscolo."
          },
          "version": {
            "type": "integer",
            "description": "La version letta insieme al cliente: se nel frattempo è cambiata, la modifica viene rifiutata.",
            "format": "uint32"
          }
        }
      },
      "UpdateRoomRequest": {
        "required": [
          "name",
          "capacity",
          "openingTime",
          "closingTime",
          "isActive",
          "version"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome mostrato nella griglia; unico senza distinguere maiuscole."
          },
          "capacity": {
            "type": "integer",
            "description": "Partecipanti massimi per prenotazione.",
            "format": "int32"
          },
          "openingTime": {
            "type": "string",
            "description": "Apertura, ora locale del coworking, a passi di mezz'ora.",
            "format": "time"
          },
          "closingTime": {
            "type": "string",
            "description": "Chiusura, dopo l'apertura, a passi di mezz'ora.",
            "format": "time"
          },
          "isActive": {
            "type": "boolean",
            "description": "false disattiva la sala: niente nuove prenotazioni, le esistenti restano."
          },
          "version": {
            "type": "integer",
            "description": "La version letta insieme alla sala: se nel frattempo è cambiata, la modifica viene rifiutata.",
            "format": "uint32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Settings"
    },
    {
      "name": "Rooms"
    },
    {
      "name": "Customers"
    },
    {
      "name": "Auth"
    }
  ]
}