    "/api/bookings": {
      "get": {
        "tags": [
          "Bookings"
        ],
        "summary": "Prenotazioni che intersecano la fascia [from, to), annullate comprese, al massimo 31 giorni.\nInsieme all'elenco delle sale basta a disegnare la griglia della disponibilità.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
