  "components": {
    "schemas": {
      "BookingResponse": {
        "required": [
          "id",
          "customerId",
          "customerName",
          "roomId",
          "roomName",
          "startsAt",
          "endsAt",
          "attendees",
          "status",
          "createdAt",
          "cancelledAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificativo della prenotazione.",
            "format": "int32"
          },
          "customerId": {
            "type": "integer",
            "description": "Cliente che ha prenotato.",
            "format": "int32"
          },
          "customerName": {
            "type": "string",
            "description": "Nome e cognome del cliente, per mostrarli senza un'altra richiesta."
          },
          "roomId": {
            "type": "integer",
            "description": "Sala prenotata.",
            "format": "int32"
          },
          "roomName": {
            "type": "string",
            "description": "Nome della sala, per mostrarlo senza un'altra richiesta."
          },
          "startsAt": {
            "type": "string",
            "description": "Inizio della fascia, in UTC.",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "description": "Fine della fascia, in UTC, esclusa dall'intervallo.",
            "format": "date-time"
          },
          "attendees": {
            "type": "integer",
            "description": "Numero di partecipanti.",
            "format": "int32"
          },
          "status": {
            "description": "Confirmed oppure Cancelled: anche le annullate restano visibili.",
            "$ref": "#/components/schemas/BookingStatus"
          },
          "createdAt": {
            "type": "string",
            "description": "Quando è stata registrata, in UTC.",
            "format": "date-time"
          },
          "cancelledAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "Quando è stata annullata, in UTC; null se è confermata.",
            "format": "date-time"
          }
        },
        "description": "Una prenotazione, con i nomi di sala e cliente già pronti da mostrare."
      },
      "BookingStatus": {
        "enum": [
          "Confirmed",
          "Cancelled"
        ],
        "description": "Stato di una prenotazione. Nel JSON compare come testo (\"Confirmed\", \"Cancelled\")."
      },
      "CreateBookingRequest": {
        "required": [
          "customerId",
          "roomId",
          "startsAt",
          "endsAt",
          "attendees"
        ],
        "type": "object",
        "properties": {
          "customerId": {
            "type": "integer",
            "description": "Cliente a nome del quale si prenota.",
            "format": "int32"
          },
          "roomId": {
            "type": "integer",
            "description": "Sala da prenotare; deve essere attiva.",
            "format": "int32"
          },
          "startsAt": {
            "type": "string",
            "description": "Inizio, con lo scarto dal fuso (ISO 8601), sull'ora o sulla mezz'ora nell'ora del coworking.",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "description": "Fine, esclusa: dopo l'inizio, nello stesso giorno e dentro gli orari della sala.",
            "format": "date-time"
          },
          "attendees": {
            "type": "integer",
            "description": "Numero di partecipanti, al massimo i posti della sala.",
            "format": "int32"
          }
        },
        "description": "Dati di una prenotazione nuova."
      },
      "CreateCustomerRequest": {
        "required": [
          "firstName",
          "lastName",
          "email"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "description": "Nome."
          },
          "lastName": {
            "type": "string",
            "description": "Cognome."
          },
          "email": {
            "type": "string",
            "description": "Email unica, senza distinguere le maiuscole; si salva in minuscolo."
          }
        },
        "description": "Dati di un cliente nuovo."
      },
      "CreateRoomRequest": {
        "required": [
          "name",
          "capacity",
          "openingTime",
          "closingTime"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome mostrato nella griglia; deve essere unico."
          },
          "capacity": {
            "type": "integer",
            "description": "Numero massimo di partecipanti a una prenotazione.",
            "format": "int32"
          },
          "openingTime": {
            "type": "string",
            "description": "Ora di apertura, nell'ora locale del coworking, sull'ora o sulla mezz'ora.",
            "format": "time"
          },
          "closingTime": {
            "type": "string",
            "description": "Ora di chiusura, dopo l'apertura, sull'ora o sulla mezz'ora.",
            "format": "time"
          }
        },
        "description": "Dati di una sala nuova, che nasce attiva."
      },
      "CustomerResponse": {
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "registeredAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificativo del cliente.",
